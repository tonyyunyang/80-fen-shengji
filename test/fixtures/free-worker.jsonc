{
  "name": "eighty-free-native-fixture",
  "main": "free-worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": { "directory": "../../dist/free-assets", "binding": "ASSETS", "run_worker_first": ["/", "/api/*", "/_eighty/*"], "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "GAME_TABLES", "class_name": "GameTable" }, { "name": "SPONSORED_AI", "class_name": "FixtureBroker" }] },
  "migrations": [{ "tag": "fixture-v1", "new_sqlite_classes": ["GameTable", "FixtureBroker"] }],
  "vars": {
    "EIGHTY_GATEWAY_SECRET": "fixture-signing-secret-not-a-real-credential",
    "SPONSOR_ALIBABA_API_KEY": "fixture-provider-secret-kept-off-the-browser",
    "SPONSORED_ENABLED": "true",
    "SPONSOR_PROFILES": "[{\"id\":\"sponsored-fixture\",\"name\":\"Hosted fixture\",\"model\":\"fixture-model\",\"baseUrl\":\"https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1\",\"keySecret\":\"SPONSOR_ALIBABA_API_KEY\"}]",
    "SPONSOR_DAILY_REQUESTS": "100",
    "SPONSOR_SESSION_REQUESTS": "50",
    "SPONSOR_VISITOR_REQUESTS": "50",
    "SPONSOR_MAX_OUTPUT_TOKENS": "512",
    "EIGHTY_TABLES_PER_DAY": "100"
  }
}
