# Optional local settings. The web UI uses per-browser keys, not server API keys.
PORT=5173
HOST=127.0.0.1
# Public hosting requires an HTTPS reverse proxy and its exact origin, no trailing slash.
# EIGHTY_PUBLIC_ORIGIN=https://game.example.com
# EIGHTY_MAX_SESSIONS=32
# EIGHTY_DATA_DIR=data
# Local self-hosted providers only; always disabled in hosted mode.
# EIGHTY_ALLOW_LOCAL_PROVIDERS=1

# Optional, opt-in CLI evaluations only. Keep actual values in ignored .env.
# QWEN_API_KEY=
# QWEN_BASE_URL=
# EVAL_MODEL=qwen3.8-flash
