{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eighty-tonytheyang",
  "main": "cloudflare/free-worker.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "eighty.tonytheyang.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_TABLES",
        "class_name": "GameTable"
      },
      {
        "name": "SPONSORED_AI",
        "class_name": "SponsoredAI"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameTable",
        "SponsoredAI"
      ]
    }
  ],
  "vars": {
    "EIGHTY_PUBLIC_ORIGIN": "https://eighty.tonytheyang.com",
    "SPONSORED_ENABLED": "false",
    "SPONSOR_PROFILES": "[]",
    "SPONSOR_DAILY_REQUESTS": "0",
    "SPONSOR_SESSION_REQUESTS": "0",
    "SPONSOR_VISITOR_REQUESTS": "0",
    "SPONSOR_MAX_OUTPUT_TOKENS": "512",
    "EIGHTY_TABLES_PER_DAY": "100"
  },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist/free-assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/_eighty/*"
    ],
    "not_found_handling": "none"
  },
  "build": {
    "command": "node scripts/build-worker-assets.mjs"
  }
}
