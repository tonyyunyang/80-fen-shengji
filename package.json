{
  "name": "eighty-shanghai",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "import:peilian": "node scripts/import-peilian.mjs",
    "media:preview": "node scripts/media-preview.mjs",
    "test:site-worker": "node scripts/verify-site-worker.mjs",
    "deploy:check": "wrangler deploy --dry-run",
    "dev:free": "node scripts/dev-free.mjs",
    "build:free": "node scripts/build-worker-assets.mjs",
    "test:free-worker": "node scripts/verify-free-worker.mjs",
    "deploy:container:check": "wrangler deploy --config wrangler.container.jsonc --dry-run"
  },
  "dependencies": {
    "ipaddr.js": "2.5.0"
  },
  "description": "A free, open-source Chinese partnership card game with animated pixel art, group dragging and local practice bots.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonyyunyang/80-fen-shengji.git"
  },
  "homepage": "https://github.com/tonyyunyang/80-fen-shengji#readme",
  "bugs": {
    "url": "https://github.com/tonyyunyang/80-fen-shengji/issues"
  },
  "devDependencies": {
    "@cloudflare/containers": "0.3.7",
    "wrangler": "4.131.1",
    "ws": "8.21.0"
  }
}
